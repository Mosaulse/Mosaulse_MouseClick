{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "model": "anthropic/claude-sonnet",
  "model_groups": {
    "lite": "anthropic/claude-haiku",
    "standard": "anthropic/claude-sonnet",
    "ultra": "anthropic/claude-opus-4-8"
  },
  "permission": {
    "bash": {
      "*": "ask",
      "python *": "allow",
      "pytest *": "allow",
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "rm -rf *": "deny"
    },
    "edit": "ask",
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
  "agent": {
    "build": {
      "model": "standard"
    },
    "plan": {
      "model": "standard"
    },
    "compose": {
      "model": "standard"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 3,
    "preserve_recent_tokens": 10000,
    "reserved": 5000
  },
  "checkpoint": {
    "thresholds": ["40%", "60%", "80%"],
    "reserved": 20000,
    "max_writer_failures": 3,
    "fork": false,
    "task_archive_days": 7,
    "memory_search_score_floor": 0.15
  },
  "memory": {
    "cc_index": false
  },
  "dream": {
    "auto": true,
    "interval_days": 7
  },
  "distill": {
    "auto": true,
    "interval_days": 30
  },
  "workflow": {
    "maxConcurrentAgents": 8,
    "maxDepth": 8
  },
  "compose": {
    "docs": "docs/compose"
  },
  "skills": {
    "paths": [".mimocode/skills"]
  },
  "lsp": {
    "python": {
      "command": ["basedpyright", "--stdio"],
      "extensions": ["py"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/Scripts"
      }
    }
  },
  "instructions": ["AGENTS.md"],
  "references": {
    "docs": {
      "path": "docs",
      "description": "架构设计文档与实现计划"
    }
  }
}